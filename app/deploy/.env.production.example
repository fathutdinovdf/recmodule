# Шаблон для /opt/recmodule/app/.env.production на VM.
# Реальные значения передавать вне гита (SSH/чат), не коммитить.

PGHOST=localhost
PGPORT=5433
PGDATABASE=recmodule
PGUSER=recmodule
PGPASSWORD=<сменить на VM, не оставлять recmodule/recmodule>

# Демо-стенд без выхода в сеть ОИС — берём данные из своей базы, не с ВМАП.
DATA_SOURCE=manual

# SMTP для заявок «Сообщить о проблеме» — опционально, можно оставить пустым.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PROBLEM_REPORT_EMAIL=

NODE_ENV=production
